# Bản trình diễn trên devnet (chương trình build với demo-time). Đổi tên thành .env.local để dùng.
VITE_CLUSTER=devnet
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=CWUPdsmDTAGh22Q7MGNHg5YhUzk5WNkcxQ7FN2etfQNS
VITE_TREASURY=4hHj5bsNyVrXwJfwDPjdyoD2dJVxLHWNVTV7ULe8kCTa
VITE_DEMO_TIME=true
VITE_MONTHLY_PRICE_LAMPORTS=20000000
# IPFS có pin, truy cập được từ trình duyệt (tự chạy Kubo hoặc dịch vụ tương thích)
VITE_IPFS_API=https://<ipfs-api>
VITE_IPFS_GATEWAY=https://<ipfs-gateway>
VITE_HEIR_KEY=threshold
VITE_RELEASE_THRESHOLD=2
# 3 nút do 3 bên khác nhau chạy (node src/server.ts --rpc https://api.devnet.solana.com --program <id>)
VITE_RELEASE_NODES=https://node1.example|<pubkey1>,https://node2.example|<pubkey2>,https://node3.example|<pubkey3>
