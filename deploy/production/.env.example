# Sao chép thành .env trên server (/opt/lifenext/deploy/production/.env) rồi điền giá trị thật.
# Sinh bí mật: openssl rand -hex 32

API_DOMAIN=deathnote-api.nonlastamp.com

# URL frontend trên Vercel (không có dấu / ở cuối) — phải khớp tuyệt đối để OIDC redirect & CORS chạy.
APP_URL=https://your-owner-web.vercel.app
ADMIN_URL=https://your-admin-console.vercel.app
# Domain phụ (không bắt buộc) cũng trỏ vào owner-web/admin-console — chỉ để mở CORS, cách nhau dấu phẩy.
# VD: EXTRA_CORS_ORIGINS=https://deathnote.picosolution.asia,https://deathnote-admin.picosolution.asia
EXTRA_CORS_ORIGINS=

# OAuth Client ID (Web) của Google cho SSO owner — trống = tắt đăng nhập Google.
# APP_URL phải nằm trong "Authorized JavaScript origins" của client này.
GOOGLE_CLIENT_ID=

POSTGRES_PASSWORD=
# Số kết nối DB tối đa của API (mặc định 60; postgres max_connections=100 trong docker-compose.yml).
# DB_MAX_POOL=60
CHECKIN_LINK_SECRET=

# Khoá chủ giữ hộ "khoá giao hàng" của người nhận thông tin (≥ 32 ký tự, ngẫu nhiên). KHÔNG đổi sau khi đã có dữ liệu —
# đổi/mất khoá là các phần đã phân cho người nhận không còn mở được. Sinh bằng: openssl rand -hex 32
ESCROW_KEY=
OPENIDDICT_CERT_PASSPHRASE=

# Resend (khuyến nghị) — có API key thì gửi qua Resend, bỏ qua SMTP bên dưới.
# RESEND_FROM phải thuộc domain đã verify trên resend.com/domains.
RESEND_API_KEY=
RESEND_FROM=Death Note <no-reply@nonlastamp.com>

# SMTP gửi email nhắc check-in / lời mời trustee (dự phòng khi không dùng Resend)
SMTP_FROM=no-reply@nonlastamp.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
